NEXT_PUBLIC_APP_NAME=LUX
NEXT_PUBLIC_APP_URL=http://127.0.0.1:30002

# Supabase. CI injects an isolated project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Never prefix with NEXT_PUBLIC and never commit a real value.
# Required by production provider callback/orchestration routes.
SUPABASE_SERVICE_ROLE_KEY=

# Adult assurance.
AGE_ASSURANCE_MODE=provider_required
AGE_ASSURANCE_PROVIDER=
AGE_ASSURANCE_PROVIDER_LABEL=
AGE_ASSURANCE_PROVIDER_BASE_URL=
AGE_ASSURANCE_PROVIDER_API_KEY=
AGE_ASSURANCE_PROVIDER_WEBHOOK_SECRET=
AGE_ASSURANCE_PROVIDER_WEBHOOK_SIGNATURE_HEADER=x-provider-signature

# Identity verification (V2/V3).
IDENTITY_VERIFICATION_PROVIDER=
IDENTITY_VERIFICATION_PROVIDER_LABEL=
IDENTITY_VERIFICATION_PROVIDER_BASE_URL=
IDENTITY_VERIFICATION_PROVIDER_API_KEY=
IDENTITY_VERIFICATION_PROVIDER_WEBHOOK_SECRET=
IDENTITY_VERIFICATION_PROVIDER_WEBHOOK_SIGNATURE_HEADER=x-provider-signature

# Supporter payment gateway.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_LABEL=
PAYMENT_PROVIDER_BASE_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
PAYMENT_PROVIDER_WEBHOOK_SIGNATURE_HEADER=x-provider-signature

# Creator/participant payout gateway.
PAYOUT_PROVIDER=
PAYOUT_PROVIDER_LABEL=
PAYOUT_PROVIDER_BASE_URL=
PAYOUT_PROVIDER_API_KEY=
PAYOUT_PROVIDER_WEBHOOK_SECRET=
PAYOUT_PROVIDER_WEBHOOK_SIGNATURE_HEADER=x-provider-signature

# CI/local-only explicit test modes. Never enable on a public production URL.
# PAYMENT_ENVIRONMENT=test
# PAYMENT_MODE=sandbox
# IDENTITY_VERIFICATION_ENVIRONMENT=test
# IDENTITY_VERIFICATION_MODE=synthetic


# Optional replaceable object-storage bridge. When unset, the Supabase storage adapter is used.
STORAGE_PROVIDER=
STORAGE_PROVIDER_LABEL=
STORAGE_PROVIDER_BASE_URL=
STORAGE_PROVIDER_API_KEY=
STORAGE_PROVIDER_WEBHOOK_SECRET=
STORAGE_PROVIDER_WEBHOOK_SIGNATURE_HEADER=x-provider-signature

# Optional replaceable streaming/CDN bridge. When unset, the Supabase streaming adapter is used.
STREAMING_PROVIDER=
STREAMING_PROVIDER_LABEL=
STREAMING_PROVIDER_BASE_URL=
STREAMING_PROVIDER_API_KEY=
STREAMING_PROVIDER_WEBHOOK_SECRET=
STREAMING_PROVIDER_WEBHOOK_SIGNATURE_HEADER=x-provider-signature


# Optional public-content moderation bridge. If unset, LUX uses its validated local rules.
MODERATION_PROVIDER=
MODERATION_PROVIDER_LABEL=
MODERATION_PROVIDER_BASE_URL=
MODERATION_PROVIDER_API_KEY=
MODERATION_PROVIDER_WEBHOOK_SECRET=
MODERATION_PROVIDER_WEBHOOK_SIGNATURE_HEADER=x-provider-signature

# Optional copyright fingerprint/watermark bridge. If unset, creator-entered fingerprints
# remain supported and watermark jobs stay queued for manual/staff processing.
MEDIA_PROTECTION_PROVIDER=
MEDIA_PROTECTION_PROVIDER_LABEL=
MEDIA_PROTECTION_PROVIDER_BASE_URL=
MEDIA_PROTECTION_PROVIDER_API_KEY=
MEDIA_PROTECTION_PROVIDER_WEBHOOK_SECRET=
MEDIA_PROTECTION_PROVIDER_WEBHOOK_SIGNATURE_HEADER=x-provider-signature
