NEXT_PUBLIC_APP_NAME=LUX
NEXT_PUBLIC_APP_URL=http://127.0.0.1:30002

# Use the hosted development project locally. CI injects an isolated local project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/CI only. Never prefix with NEXT_PUBLIC and never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=

# Production defaults to provider_required. Use self_attestation only for approved
# local/CI testing or a jurisdiction policy that explicitly allows it.
AGE_ASSURANCE_MODE=provider_required
